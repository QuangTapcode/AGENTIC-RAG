# Copy to .env and fill in what you use. Nothing here is committed.

# ---- Qdrant ----
# URL for the local Qdrant instance (docker-compose default).
QDRANT_URL=http://localhost:6333

# ---- Embedding model ----
# HuggingFace model id used for both indexing and dense retrieval.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---- Reranker model ----
# Cross-encoder used by the optional reranking stage.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ---- Local LLM (recommended for this prototype) ----
# Ollama must be running locally and the model must already be pulled.
# The Streamlit UI enables this by default; the CLI/evaluation use --local-qwen.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# ---- Cloud LLM (optional) ----
# The AnswerGenerator falls back to grounded evidence excerpts when no LLM
# hook is configured. Set exactly one provider block if you want a generated
# answer. Do not enable more than one.
#
# Anthropic Claude (recommended default: claude-opus-4-7 or claude-sonnet-4-6):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
#
# OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- HuggingFace (optional) ----
# Personal access token — raises rate limits for model downloads.
# HF_TOKEN=hf_...

# ---- Logging (optional) ----
# Path for router feedback log (JSONL). If unset, feedback is not persisted.
# ROUTER_LOG_PATH=logs/router_feedback.jsonl
